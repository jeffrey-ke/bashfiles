#!/bin/bash
# Shell integration for CLI tools installed by install-tools.sh.
# Each block is a no-op if the tool isn't installed.

case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# On macOS install-tools.sh delegates to Homebrew, which lands in /opt/homebrew on
# Apple Silicon — not on the default PATH, and its installer only prints the shellenv
# line for you to add yourself. Without this, brew-installed tools are invisible both
# to install-tools.sh's `command -v brew` guard and to every check below, so the
# integration silently no-ops as if nothing were installed. Must stay above those
# checks; guarded, so it does nothing on Linux.
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# Source a directory's .aliases on the way into it, for every component of the
# new path. Every navigation entry point calls this — zoxide's `cd` and `cdi`,
# yazi's `y` — since each lands somewhere new by a different route, and only
# `cd` used to do it. Lives at top level, not in the zoxide block below, so `y`
# still gets it on a machine without zoxide installed.
# `local _CD_SOURCING` is visible to callees, so an .aliases that itself calls
# cd walks no further.
_source_path_aliases() {
	[[ -n "$_CD_SOURCING" ]] && return 0
	local _CD_SOURCING=1
	local accumulator="" remaining="${PWD#/}"
	while [[ -n "$remaining" ]]; do
		if [[ "$remaining" == */* ]]; then
			accumulator+="/${remaining%%/*}"
			remaining="${remaining#*/}"
		else
			accumulator+="/$remaining"
			remaining=""
		fi
		if [[ -f "$accumulator/.aliases" ]]; then
			echo "Sourcing $accumulator/.aliases:"
			cat "$accumulator/.aliases"
			source "$accumulator/.aliases"
		fi
	done
	return 0
}

if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init --cmd cd bash)"

	# These wrap zoxide's own `cd`/`cdi`, so they have to live here, after the
	# eval above: .bashrc sources .functions.sh *before* .bash_tools, so
	# defining them there — the intuitive home for a shell function — would be
	# silently clobbered by zoxide's init. That ordering is why this lived in a
	# machine file instead.
	cd() {
		__zoxide_z "$@" || return $?
		_source_path_aliases
	}

	cdi() {
		__zoxide_zi "$@" || return $?
		_source_path_aliases
	}
fi

if command -v fzf >/dev/null 2>&1; then
	eval "$(fzf --bash)"
	export FZF_COMPLETION_TRIGGER='~~'

	# Ctrl-T finder directory navigation (yazi-style hjkl mnemonics):
	#   Ctrl-H   up to the parent directory (repeatable)
	#   Ctrl-L   descend into the highlighted directory (no-op on files)
	#   Ctrl-D   jump back to the directory Ctrl-T was originally opened in
	# `become` replaces the fzf process via execve after `cd`, so the new
	# process's cwd genuinely changes — hops compose correctly across presses.
	# Overrides fzf's default ctrl-h (backspace; the physical Backspace key is
	# unaffected, it sends a separate 'bspace' code), ctrl-l (clear-screen),
	# and ctrl-d (delete char / abort-if-empty-query); use Ctrl-C to
	# abort/restart the query instead.
	# Ctrl-L always becomes (rather than using a `transform` to check first)
	# because fzf's `transform` action silently stops firing on any process
	# reached via `become` — confirmed empirically against fzf 0.70; `become`
	# and `execute-silent` are unaffected. So the directory check happens
	# inside the function instead: not-a-directory is a harmless no-op relaunch.
	# Each relaunch stamps its cwd into _FZF_CTRL_T_CWDFILE. Env vars set
	# inside the become chain can't propagate back to the widget below (the
	# chain runs in a subshell), so this file is the only channel back out —
	# it's how the widget learns which directory the final accept happened
	# in, to rebase the selection onto the origin dir.
	_fzf_ctrl_t_relaunch() {
		[ -n "${_FZF_CTRL_T_CWDFILE:-}" ] && printf '%s' "$PWD" >"$_FZF_CTRL_T_CWDFILE"
		FZF_DEFAULT_COMMAND=${FZF_CTRL_T_COMMAND:-} \
			FZF_DEFAULT_OPTS="--reverse --walker=file,dir,follow,hidden --scheme=path --header=\"$PWD\" ${FZF_CTRL_T_OPTS:-} -m" \
			FZF_DEFAULT_OPTS_FILE='' fzf
	}
	export -f _fzf_ctrl_t_relaunch
	_fzf_ctrl_t_up() {
		cd .. 2>/dev/null || return
		_fzf_ctrl_t_relaunch
	}
	export -f _fzf_ctrl_t_up
	_fzf_ctrl_t_down() {
		[ -d "$1" ] && cd -- "$1" 2>/dev/null
		_fzf_ctrl_t_relaunch
	}
	export -f _fzf_ctrl_t_down
	_fzf_ctrl_t_origin() {
		cd -- "${_FZF_CTRL_T_ORIGIN:-.}" 2>/dev/null || return
		_fzf_ctrl_t_relaunch
	}
	export -f _fzf_ctrl_t_origin
	export FZF_CTRL_T_OPTS='--bind "ctrl-h:become(_fzf_ctrl_t_up),ctrl-d:become(_fzf_ctrl_t_origin),ctrl-l:become(_fzf_ctrl_t_down {})"'

	# fzf's own Ctrl-T widget doesn't remember where it started, so wrap it to
	# stamp the origin dir first; _fzf_ctrl_t_origin above reads it back.
	# It also reimplements fzf-file-widget's body instead of just calling it,
	# so the raw selection (relative to wherever the picker ended up after
	# any Ctrl-H/L hops) can be rebased onto the origin dir before insertion —
	# paths inserted into the command line are always relative to where
	# Ctrl-T was pressed, regardless of how far the picker wandered.
	# Uses _fzf_ctrl_t_relaunch (not fzf's own __fzf_select__) for the initial
	# launch too, so the header and binds are consistent from the first press
	# — __fzf_select__ builds its own FZF_DEFAULT_OPTS via fzf's __fzf_defaults
	# and knows nothing about them, otherwise the header only appears starting
	# from the first Ctrl-H/L/D hop.
	_fzf_ctrl_t_widget() {
		local origin="$PWD" cwdfile selected final_cwd raw tok rebased=()
		export _FZF_CTRL_T_ORIGIN="$origin"
		cwdfile="$(mktemp -t fzf-ctrl-t-cwd.XXXXXX)"
		printf '%s' "$origin" >"$cwdfile"
		export _FZF_CTRL_T_CWDFILE="$cwdfile"

		selected="$(_fzf_ctrl_t_relaunch | while read -r item; do printf '%q ' "$item"; done)"
		final_cwd="$(command cat -- "$cwdfile" 2>/dev/null)"
		rm -f -- "$cwdfile"

		if [ -n "$selected" ] && [ -n "$final_cwd" ] && [ "$final_cwd" != "$origin" ]; then
			eval "raw=($selected)"
			for tok in "${raw[@]}"; do
				rebased+=("$(realpath --relative-to="$origin" -- "$final_cwd/$tok" 2>/dev/null || printf '%s' "$tok")")
			done
			selected=""
			for tok in "${rebased[@]}"; do
				selected+="$(printf '%q ' "$tok")"
			done
		fi

		READLINE_LINE="${READLINE_LINE:0:READLINE_POINT}$selected${READLINE_LINE:READLINE_POINT}"
		READLINE_POINT=$((READLINE_POINT + ${#selected}))
	}
	bind -m emacs-standard -x '"\C-t": _fzf_ctrl_t_widget'
	bind -m vi-command -x '"\C-t": _fzf_ctrl_t_widget'
	bind -m vi-insert -x '"\C-t": _fzf_ctrl_t_widget'
fi

if command -v grab >/dev/null 2>&1; then
	_grab_insert() {
		local sel
		sel=$(grab) || return
		[ -n "$sel" ] || return
		READLINE_LINE="${READLINE_LINE:0:$READLINE_POINT}$sel${READLINE_LINE:$READLINE_POINT}"
		READLINE_POINT=$((READLINE_POINT + ${#sel}))
	}
	bind -x '"\C-g": _grab_insert'
	bind -m vi-insert -x '"\C-g": _grab_insert'
	bind -m vi-command -x '"\C-g": _grab_insert'
fi

if command -v yazi >/dev/null 2>&1; then
	# yazi cwd-on-exit wrapper
	function y() {
		local tmp cwd
		tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
		yazi "$@" --cwd-file="$tmp"
		if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
			builtin cd -- "$cwd" && _source_path_aliases
		fi
		rm -f -- "$tmp"
	}
fi
