[user]
	email = jke3@cs.cmu.edu
	name = jeff
[pull]
	rebase = true
[diff]
	tool = vimdiff
	algorithm = patience
[merge]
	tool = vimdiff
[git]
	editor = vim
[difftool]
	prompt = false
[alias]
    co = checkout
    br = branch
    a  = add
    rc = rebase --continue
    mt = mergetool
[mergetool]
	prompt = false
[core]
	editor = vim
[credential "https://github.com"]
	helper = 
	helper = !/home/jeffk/miniconda3/envs/gcv/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/jeffk/miniconda3/envs/gcv/bin/gh auth git-credential
[core]
	editor = vim
