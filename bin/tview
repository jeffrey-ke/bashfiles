#!/usr/bin/env bash
# tview -- show text, or a command's output, in a tmux split or popup, paged with less.
#
#   tview split [--name N] [-v] [-l SIZE] [--focus] [--rerender] [FILE | -- CMD...]
#   tview popup [-w W] [-h H] [FILE | -- CMD...]
#
# With neither FILE nor CMD it pages stdin, saved first under ~/.cache/tview/<name>/.
# CMD runs inside the new pane or popup, so it sees that terminal's size and tty, which
# renderers like mdmath need. `split --name N` reuses the pane already tagged N in this
# window, respawning it with the new content, instead of opening another. `--rerender`
# re-runs CMD whenever the pane is resized, for renderers that lay out to the pane width;
# the pager reopens at the top.
set -euo pipefail

die() { echo "tview: $*" >&2; exit 1; }

# Internal: `tview _rerender OUTFILE CMD...` is what --rerender runs inside the pane. Its
# less flags mirror $pager below.
if [[ ${1:-} == _rerender ]]; then
	out=$2
	shift 2
	resized=0
	trap 'resized=1' WINCH
	while :; do
		"$@" >"$out" 2>&1 || true
		# Backgrounded so the WINCH trap can interrupt `wait`; bash defers traps while a
		# foreground child runs.
		less -R -+F -- "$out" </dev/tty &
		pid=$!
		until ((resized)) || ! kill -0 "$pid" 2>/dev/null; do
			wait "$pid" || true
		done
		((resized)) || exit 0
		# Debounce: a border drag sends a burst of WINCHes; render once it settles.
		while ((resized)); do
			resized=0
			sleep 0.3
		done
		kill "$pid" 2>/dev/null || true
		wait "$pid" || true
		# less was killed mid-screen: restore the tty modes and leave its alternate screen.
		stty sane
		tput rmcup || true
	done
fi

mode=${1:-}
[[ $mode == split || $mode == popup ]] || die "usage: tview split|popup [options] [FILE | -- CMD...]"
shift

name=view vertical=0 size=45% focus=0 width=80% height=80% rerender=0
while (($#)); do
	case $1 in
	--name) name=$2; shift 2 ;;
	-v) vertical=1; shift ;;
	-l) size=$2; shift 2 ;;
	--focus) focus=1; shift ;;
	--rerender) rerender=1; shift ;;
	-w) width=$2; shift 2 ;;
	-h) height=$2; shift 2 ;;
	--) shift; break ;;
	-*) die "unknown option $1" ;;
	*) break ;;
	esac
done

[[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]] || die "not inside tmux"

# -+F: a LESS=-F in the environment would quit on short content and close the pane at once.
pager='less -R -+F'
dir="$HOME/.cache/tview/$name"
mkdir -p "$dir"
file="$dir/$(date +%Y%m%d-%H%M%S-%N).txt"
if [[ ${1:-} && -f $1 && $# -eq 1 ]]; then
	cmd="exec $pager -- $(printf '%q' "$(realpath "$1")")"
elif ((rerender)); then
	(($#)) || die "--rerender needs a CMD"
	[[ $mode == split ]] || die "--rerender only works with split"
	cmd="exec $(printf '%q' "$(realpath "${BASH_SOURCE[0]}")") _rerender $(printf '%q' "$file") $(printf '%q ' "$@")"
elif (($#)); then
	# CMD finishes before less starts: a renderer querying the terminal would otherwise race
	# less for the replies on the tty.
	cmd="$(printf '%q ' "$@") >$(printf '%q' "$file") 2>&1; exec $pager -- $(printf '%q' "$file")"
else
	cat >"$file"
	cmd="exec $pager -- $(printf '%q' "$file")"
fi

if [[ $mode == popup ]]; then
	session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
	client=$(tmux list-clients -t "$session" -F '#{client_name}' | head -n 1)
	[[ -n $client ]] || die "no client is attached to session $session"
	# run-shell -b: display-popup would otherwise hold this command until the popup closes.
	tmux run-shell -b "tmux display-popup -c $(printf '%q' "$client") -E -w $width -h $height \
		-d $(printf '%q' "$PWD") $(printf '%q' "$cmd")"
	exit 0
fi

pane=$(tmux list-panes -t "$TMUX_PANE" -F '#{pane_id} #{@tview}' | awk -v n="$name" '$2 == n { print $1; exit }')
if [[ -n $pane ]]; then
	tmux respawn-pane -k -t "$pane" -c "$PWD" "$cmd"
else
	args=(-t "$TMUX_PANE" -l "$size" -c "$PWD" -P -F '#{pane_id}')
	((vertical)) && args+=(-v) || args+=(-h)
	((focus)) || args+=(-d)
	pane=$(tmux split-window "${args[@]}" "$cmd")
	tmux set-option -p -t "$pane" @tview "$name"
fi
((focus)) && tmux select-pane -t "$pane"
echo "tview: $name in pane $pane (undo: tmux kill-pane -t $pane)"
