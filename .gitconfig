[user]
	email = jeffke613@gmail.com
	name = Jeffrey Ke
[pull]
	rebase = true
[diff]
	tool = vimdiff
	algorithm = patience
[merge]
	tool = vimdiff
[git]
	editor = vim
[difftool]
	prompt = false
	trustExitCode = true
[alias]
    co = checkout
    br = branch
    a  = add
    rc = rebase --continue
    mt = mergetool
	cof = config
	rp = rev-parse
	foreachref = for-each-ref
	foreref = for-each-ref
	mb = merge-base
	mybrs = !git for-each-ref --sort=-committerdate --format='%(refname:short) %(committername)' refs/heads/ | grep Jeffrey
	graph = log --graph --oneline --decorate
	cp = cherry-pick
[mergetool]
	prompt = false
[core]
	editor = vim
	excludesFile = ~/.gitignore_global
# Resolved off PATH, not an absolute path: this file is shared across machines and
# the old hard-coded /ocean/.../bin/gh exists only on PSC. The PSC machine files
# put that directory on PATH, so the helper keeps working there.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
