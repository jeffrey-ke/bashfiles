export GIT_EDITOR=vim
export EDITOR=nvim

set -o vi

# macOS's /bin/bash is 3.2, and it nags about zsh on every login shell once $SHELL
# points at it. Scoped to the OS rather than a host, which machines/ can't express
# (it keys on `hostname -s`); an unused variable elsewhere.
export BASH_SILENCE_DEPRECATION_WARNING=1

# Override Ubuntu's stock ignoreboth: ignorespace silently drops any command
# from history whose first physical line starts with whitespace, which is
# an easy accident on multi-line pastes (indented continuation lines, code
# copied from markdown/chat). ignoredups alone still collapses repeats.
export HISTCONTROL=ignoredups

# bash-git-prompt is sourced by .bash_prompt alone. It used to be sourced here
# and in the (now deleted) .setup as well, which meant three loads per shell.
