#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml"]
# ///
"""run — name-keyed training-run registry over rsync/ssh remotes (sibling of `art`).

A training run lives under <dir>/<name>/ (config.yaml, hparams.yaml, git_commit.txt, metrics.csv,
descriptor.yaml, *.patch, checkpoints/**; sweep umbrellas nest one level: <name>/<arm>/...). This
pushes/pulls that history to a remote so any machine sharing the remote can fetch a run pushed from
elsewhere. It deliberately skips wandb/ (canonical copy is in the wandb cloud) and viz/ (regenerable
from ckpts).

Usage:
    run list <remote> [name] [--size] table of entries (name + KIND + mtime + local?); each is a
                                      leaf `run` or a `sweep` (folder-of-runs). Pass a sweep name to
                                      drill into its arms. --size adds a CKPT column (~20s/Lustre).
    run local [remote] [name] [--size] [--paths]  same table, sourced from local disk only — no
                                      network. Remote is optional when every configured remote shares
                                      one local dir (the common case); pass one explicitly if they
                                      diverge. --paths prints bare abs paths, one per row (for pipes).
    run path [remote] <name>          print the abs local dir of one run to stdout — the composable
                                      handle other tools consume, e.g.
                                      `seg-model create t40 --from-run $(run path hpo-v3/t40)`.
    run pull <remote> <name ...> [-n] fetch run history  <- remote   (-n / rsync flags pass through)
    run push <remote> <name ...> [-n] push run history   -> remote
                                      <name> may be a sweep arm, e.g. m2f-fullgrid-hpo-v3/t40

All remote I/O is rsync (list/size via `rsync --list-only`, path creation via `--mkpath`) — never a
raw `ssh <host> <cmd>`, since a PSC Data Transfer Node allows rsync but rejects arbitrary commands.

Remotes are defined in the nearest .runs.yaml walking UP from cwd, or --config <path> / $RUN_CONFIG:
    <remote>: {host: <rsync ssh alias>, root: <remote abs path>, dir: <ws-relative runs dir>}
`dir` resolves relative to the .runs.yaml (cwd-independent) and is workspace-relative, so the local
tree (<yaml parent>/<dir>/<name>) and the remote tree (<root>/<dir>/<name>) share the same suffix.
A missing file or remote is a LOUD exit; the resolved (remote, file, host:root/dir) echoes to stderr.

    run push psc m2ffix         # push one run (or sweep umbrella) up
    run pull psc m2ffix -n      # dry-run preview of the pull

Composing with seg-model (a run dir is self-describing: checkpoints/ + descriptor.yaml):
    seg-model create t40 --from-run $(run path m2f-fullgrid-hpo-v3/t40)
    run local --paths | fzf | xargs seg-model create t40 --from-run
"""
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # -> real dotfiles/bin, not the ~/.local/bin symlink
import registry  # noqa: E402  shared walk-up YAML registry mechanism (see registry.py)

# rsync filter: prune wandb/ + viz/ FIRST, then allow directory recursion (so sweep umbrellas like
# m2ffix/<arm>/ are descended into), then keep the history files at any depth, drop everything else.
# -m prunes the empty dir shells the '*/' include would otherwise leave behind. Unanchored basenames
# (hparams.yaml, ...) match at any depth, so nested sweep arms sync correctly (the old sync-run-*.sh
# scripts dropped them: their trailing --exclude='*' pruned <arm>/ before rsync could descend).
FILTER = [
    "--exclude=wandb/", "--exclude=viz/",
    "--include=*/",
    "--include=config.yaml", "--include=hparams.yaml", "--include=git_commit.txt",
    "--include=metrics.csv", "--include=descriptor.yaml", "--include=*.patch",
    "--include=checkpoints/**",
    "--exclude=*",
]


def _sync(passthrough, src, dst):
    # rsync auto-creates the final leaf dir (<name>/) when its parent exists; the remote
    # <root>/<dir> (segmentation/runs) already exists on the hub, so no `ssh mkdir` is needed
    # (the DTN would reject it anyway, and PSC's rsync 3.1.3 predates --mkpath).
    subprocess.run(["rsync", "-avP", "-m", *passthrough, *FILTER, src, dst], check=True)


def _rsync_list(args):
    # `run` talks ONLY over rsync: PSC's DTN allows the rsync binary but rejects arbitrary ssh
    # ("Login denied: ... is not an allowed command"), so listing/sizing uses `rsync --list-only`,
    # not `ssh du`. Fail loud on a nonzero rc so a dead socket / bad path never reads as "no runs".
    r = subprocess.run(["rsync", "--list-only", *args], capture_output=True, text=True)
    if r.returncode != 0:
        if "No such file or directory" in r.stderr:
            sys.exit(f"run: remote path does not exist: {args[-1]}\n"
                     "     (a worktree remote may have been removed — check .runs.yaml)")
        sys.exit(f"run: rsync --list-only failed (rc={r.returncode}):\n{r.stderr.strip()}")
    return r.stdout


def _human(n):
    x = float(n)
    for unit in ("B", "K", "M", "G", "T"):
        if x < 1024 or unit == "T":
            return f"{x:.0f}{unit}" if unit == "B" else f"{x:.1f}{unit}"
        x /= 1024


def _parse(line):
    # rsync --list-only row: "<perms> <size> <date> <time> <name>" (size has thousands commas).
    parts = line.split(None, 4)
    return parts if len(parts) == 5 else None


def _do_list(host, root, rel, sub, local_dir, want_size):
    rel_full = f"{rel}/{sub}" if sub else rel
    base = f"{host}:{root}/{rel_full}/"
    local_base = local_dir / sub if sub else local_dir
    # Shallow list (instant, ~0.1s): immediate child dirs + mtime. Skip the '.' self-entry and
    # top-level files (e.g. Optuna .journal study DBs).
    dirs = [(p[4], p[2]) for line in _rsync_list([base]).splitlines()
            if (p := _parse(line)) and p[0].startswith("d") and p[4] != "."]
    if not dirs:
        print(f"no runs on {base}")
        return
    # Leaf run vs sweep umbrella: a child is a leaf *run* if it DIRECTLY holds hparams.yaml
    # (Lightning writes one per run); otherwise it is a folder-of-runs (a sweep, e.g.
    # m2f-fullgrid-hpo-v3/t0..t90) — drill in with `run list <remote> <name>`, pull one arm with
    # `run pull <remote> <name>/<arm>`. 1-level probe, prunes wandb/viz so it stays cheap.
    leaves = set()
    for line in _rsync_list(["-r", "--exclude=wandb/", "--exclude=viz/",
                             "--include=/*/", "--include=/*/hparams.yaml", "--exclude=*",
                             base]).splitlines():
        p = _parse(line)
        if p and p[0].startswith("-") and p[4].endswith("hparams.yaml"):
            leaves.add(p[4].split("/", 1)[0])
    # Ckpt size is opt-in (--size): a checkpoints-filtered recursive list (~20s over Lustre; prune
    # wandb/viz so rsync skips each run's thousands of media/log files). Summed by top path
    # component so a leaf run and a whole sweep (all its arms' checkpoints) both attribute.
    ckpt = {}
    if want_size:
        for line in _rsync_list(["-r", "--exclude=wandb/", "--exclude=viz/", "--include=*/",
                                 "--include=checkpoints/***", "--exclude=*", base]).splitlines():
            p = _parse(line)
            if p and p[0].startswith("-"):
                top = p[4].split("/", 1)[0]
                ckpt[top] = ckpt.get(top, 0) + int(p[1].replace(",", ""))
    rows = [(n, "run" if n in leaves else "sweep", date,
             _human(ckpt[n]) if n in ckpt else ("—" if want_size else ""),
             "✓" if (local_base / n).exists() else "–") for n, date in sorted(dirs)]
    w = max(len(r[0]) for r in rows)
    ws = max((len(r[3]) for r in rows), default=4)
    size_hdr = f"{'CKPT':>{ws}}  " if want_size else ""
    print(f"{'RUN':<{w}}  {'KIND':<5}  {'MTIME':<10}  {size_hdr}LOCAL")
    for n, kind, date, size, present in rows:
        size_col = f"{size:>{ws}}  " if want_size else ""
        print(f"{n:<{w}}  {kind:<5}  {date:<10}  {size_col}{present}")


def _mtime(p):
    return datetime.fromtimestamp(p.stat().st_mtime).strftime("%Y/%m/%d")


def _do_local(local_dir, sub, want_size, want_paths=False):
    base = local_dir / sub if sub else local_dir
    if not base.is_dir():
        sys.exit(f"run: no local runs dir: {base}")
    # Same "d" vs "-" distinction the remote --list-only path makes (skip sibling files like
    # <study>.journal) — just via os.scandir instead of parsing rsync rows.
    dirs = [(p.name, _mtime(p)) for p in base.iterdir() if p.is_dir()]
    if not dirs:
        print(f"no local runs under {base}", file=sys.stderr if want_paths else sys.stdout)
        return
    if want_paths:  # bare abs paths, no header — stdout stays clean for pipes / fzf / xargs
        for n, _ in sorted(dirs):
            print(base / n)
        return
    # Leaf run vs sweep umbrella: identical 1-level hparams.yaml probe to _do_list, just local.
    leaves = {n for n, _ in dirs if (base / n / "hparams.yaml").is_file()}
    ckpt = {}
    if want_size:
        for n, _ in dirs:
            total = sum(f.stat().st_size for f in (base / n).rglob("checkpoints/**/*") if f.is_file())
            if total:
                ckpt[n] = total
    rows = [(n, "run" if n in leaves else "sweep", date,
             _human(ckpt[n]) if n in ckpt else ("—" if want_size else ""))
            for n, date in sorted(dirs)]
    w = max(len(r[0]) for r in rows)
    ws = max((len(r[3]) for r in rows), default=4)
    size_hdr = f"{'CKPT':>{ws}}  " if want_size else ""
    print(f"{'RUN':<{w}}  {'KIND':<5}  {'MTIME':<10}  {size_hdr}".rstrip())
    for n, kind, date, size in rows:
        size_col = f"{size:>{ws}}  " if want_size else ""
        print(f"{n:<{w}}  {kind:<5}  {date:<10}  {size_col}".rstrip())


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.exit(__doc__)
    # find_config consumes --config in place, so resolve it before splitting verb/remote/names.
    cfg = registry.find_config(".runs.yaml", "RUN_CONFIG", argv)
    if not argv:
        sys.exit(__doc__)

    verb, rest = argv[0], argv[1:]

    if verb in ("local", "path"):
        want_size = any(a in ("--size", "-s") for a in rest)
        want_paths = "--paths" in rest
        subs = [a for a in rest if not a.startswith("-")]
        spec = registry.all_entries(cfg)
        remote = subs[0] if subs and subs[0] in spec else None
        name = subs[1] if remote else (subs[0] if subs else None)
        if remote:
            local_dir = registry.resolve_dir(cfg, spec[remote])
        else:
            all_dirs = {registry.resolve_dir(cfg, e) for e in spec.values()}
            if len(all_dirs) > 1:
                sys.exit("run: remotes resolve to different local dirs "
                         f"({', '.join(sorted(map(str, all_dirs)))}) — pass one explicitly, "
                         f"e.g. `run {verb} {next(iter(spec))}`")
            local_dir = all_dirs.pop()
        print(f"[run: local via {cfg} -> {local_dir}]", file=sys.stderr)
        if verb == "path":
            # The composable handle: one bare abs path on stdout, for $() / xargs consumers.
            if not name:
                sys.exit("run: path requires a run name — try `run local`")
            target = local_dir / name
            if not target.is_dir():
                sys.exit(f"run: no such local run: {target}\n"
                         f"     (fetch it first: `run pull <remote> {name}`, or see `run local`)")
            print(target)
            return
        _do_local(local_dir, name, want_size, want_paths)
        return

    if not rest:
        sys.exit(__doc__)
    remote, rest = rest[0], rest[1:]
    e = registry.entry(cfg, remote, "run")
    host, root, rel = e["host"], e["root"], e["dir"]
    local_dir = registry.resolve_dir(cfg, e)
    print(f"[run: {remote} via {cfg} -> {host}:{root}/{rel}]", file=sys.stderr)

    if verb == "list":
        subs = [a for a in rest if not a.startswith("-")]
        want_size = any(a in ("--size", "-s") for a in rest)
        _do_list(host, root, rel, subs[0] if subs else "", local_dir, want_size)
        return

    if verb not in ("push", "pull"):
        sys.exit(__doc__)

    names = [a for a in rest if not a.startswith("-")]
    passthrough = [a for a in rest if a.startswith("-")]
    if not names:
        sys.exit(f"run: {verb} requires a run name (runs are large) — try `run list {remote}`")
    # Probe the remote runs dir before transferring: a registered remote can be a worktree that
    # was later removed, and that must fail loud here, not as a mid-sync rsync traceback.
    _rsync_list([f"{host}:{root}/{rel}/"])

    for name in names:
        local = local_dir / name
        remote_path = f"{host}:{root}/{rel}/{name}"
        if verb == "push":
            if not local.is_dir():
                sys.exit(f"run: no such local run: {local}")
            # rsync --mkpath (in _sync) creates root/rel/<name>/ — the DTN forbids `ssh mkdir`.
            print(f"=== push {name} -> {remote_path}/ (skipping wandb/ + viz/) ===")
            _sync(passthrough, f"{local}/", f"{remote_path}/")
        else:  # pull
            os.makedirs(local, exist_ok=True)
            print(f"=== pull {name} <- {remote_path}/ (skipping wandb/ + viz/) ===")
            _sync(passthrough, f"{remote_path}/", f"{local}/")


if __name__ == "__main__":
    main()
