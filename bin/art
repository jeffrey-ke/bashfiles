#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["huggingface-hub>=0.25", "pyyaml"]
# ///
"""art — generic artifact registry over Hugging Face.

Three namespaces, one private HF repo each:
    dataset     render umbrellas    (jeffke613/refseg-datasets)
    asset       sim usdz inputs     (jeffke613/refseg-assets)
    checkpoint  model weights       (jeffke613/refseg-checkpoints)

Usage:
    art ls   <ns>
    art pull <ns> [name ...] [-y]
    art push <ns> [name ...] [-y]

Config is the nearest .artifacts.yaml walking UP from cwd (git-style), or
--config <path> / $ART_CONFIG. Each namespace entry is
    <ns>: {repo: owner/name, dir: <rel path>, require_name?: bool, ignore?: [globs]}
where `dir` resolves relative to the .artifacts.yaml (so it is cwd-independent).
A missing file or namespace is a LOUD exit (no silent fallback); the resolved
(ns, file, repo) is echoed to stderr on every run.

    art pull dataset shelf-optflow   # scoped: datasets are huge (require_name: true)
    art pull checkpoint              # all weights (require_name: false)
    art push dataset                 # mirror the whole tree up (incremental)
    art push asset graspable_objects # push one subtree
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # -> real dotfiles/bin, not the ~/.local/bin symlink
import registry  # noqa: E402  shared walk-up YAML registry mechanism (see registry.py)

from huggingface_hub import HfApi, snapshot_download, upload_folder, upload_large_folder  # noqa: E402

REPO_TYPE = "dataset"  # one HF repo per namespace; dataset-type holds arbitrary files


def main():
    argv = sys.argv[1:]
    yes = False
    for flag in ("-y", "--yes"):
        if flag in argv:
            yes = True
            argv.remove(flag)
    if len(argv) < 2:
        sys.exit(__doc__)
    # find_config consumes --config in place, so resolve it before splitting verb/ns/names;
    # re-check length in case --config was the only reason argv looked long enough.
    cfg = registry.find_config(".artifacts.yaml", "ART_CONFIG", argv)
    if len(argv) < 2:
        sys.exit(__doc__)

    verb, ns, names = argv[0], argv[1], argv[2:]
    e = registry.entry(cfg, ns, "art")
    repo, local_dir = e["repo"], registry.resolve_dir(cfg, e)
    require_name, ignore = e.get("require_name", False), e.get("ignore", [])
    print(f"[art: {ns} via {cfg} -> {repo}]", file=sys.stderr)
    api = HfApi()

    if verb == "ls":
        for t in api.list_repo_tree(repo, repo_type=REPO_TYPE, recursive=False):
            print(t.path)
    elif verb == "pull":
        if require_name and not names:
            sys.exit(f"art: {ns} requires a name (repo may be huge) — try `art ls {ns}`")
        allow = [pat for n in names for pat in (n, f"{n}/**")] or None
        snapshot_download(repo, repo_type=REPO_TYPE, local_dir=str(local_dir), allow_patterns=allow)
        print(f"pulled {names or 'ALL'} <- {repo} -> {local_dir}")
    elif verb == "push":
        if not yes and input(f"push {names or local_dir} -> {repo}? [y/N] ").strip().lower() not in ("y", "yes"):
            sys.exit("aborted")
        api.create_repo(repo, repo_type=REPO_TYPE, private=True, exist_ok=True)
        if names:
            for n in names:
                upload_folder(repo_id=repo, repo_type=REPO_TYPE, folder_path=str(local_dir / n),
                              path_in_repo=n, ignore_patterns=ignore)
        else:
            upload_large_folder(repo_id=repo, repo_type=REPO_TYPE, folder_path=str(local_dir),
                                ignore_patterns=ignore)
        print(f"pushed {names or 'ALL'} -> {repo}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
